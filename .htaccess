# GKA Construction ERP - Hostinger Reverse Proxy & Static Optimization
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Directly serve existing physical files in the current directory
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Check if the file physically exists inside client/dist/
    RewriteCond %{DOCUMENT_ROOT}/client/dist/$1 -f [OR]
    RewriteCond client/dist/$1 -f
    RewriteRule ^(.*)$ client/dist/$1 [L]

    # 3. Check if the file physically exists inside dist/
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
    RewriteCond dist/$1 -f
    RewriteRule ^(.*)$ dist/$1 [L]

    # 4. Proxy API & uploads directly to Node.js backend
    RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
    RewriteRule ^uploads/(.*)$ http://127.0.0.1:5000/uploads/$1 [P,L]

    # 5. Never send missing JS, CSS, or media assets to the HTML fallback
    RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map|json|txt|xml|pdf)$ [NC]
    RewriteRule ^ - [R=404,L]

    # 6. SPA HTML fallback for frontend routing
    RewriteCond %{DOCUMENT_ROOT}/client/dist/index.html -f
    RewriteRule ^.*$ client/dist/index.html [L]

    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^.*$ dist/index.html [L]

    RewriteCond client/dist/index.html -f
    RewriteRule ^.*$ client/dist/index.html [L]

    RewriteCond dist/index.html -f
    RewriteRule ^.*$ dist/index.html [L]

    # 7. Fallback proxy to Node.js
    RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L]
</IfModule>

<IfModule mod_proxy.c>
    ProxyRequests Off
    ProxyPreserveHost On
    ProxyPassReverse / http://127.0.0.1:5000/
</IfModule>
