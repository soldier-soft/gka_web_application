# ==============================================================================
# GKA CONSTRUCTION ERP & CLIENT PORTAL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=production
CLIENT_URL=https://www.gkaconstruction.com

# MongoDB Database Connection (MongoDB Atlas or Local Instance)
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.zzm5awx.mongodb.net/gka_construction_erp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://elangovanit5012_db_user:<password>@cluster0.zzm5awx.mongodb.net/gka_construction_erp?retryWrites=true&w=majority

# Security & Authentication
JWT_SECRET=replace-with-a-robust-64-character-cryptographic-secret-key-2026
JWT_EXPIRES_IN=7d

# File Storage & Uploads
UPLOAD_DIR=./uploads
# Cloud Storage Options (AWS S3 or Cloudinary for Private Object Storage)
# CLOUDINARY_CLOUD_NAME=gka-construction
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email & Notifications (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=gkaconstruction51@gmail.com
# SMTP_PASS=your_app_specific_password
# SMTP_FROM="GKA Construction" <gkaconstruction51@gmail.com>

# Frontend Configuration (for client build / .env)
VITE_API_URL=https://www.gkaconstruction.com/api/v1
